      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "summarize-content"
    },
    {
      "parameters": {
        "jsCode": "const content = $input.item.json.content;\nconst style = $input.item.json.style || 'concise';\nconst length = $input.item.json.length || 'short';\n\nlet instruction = '';\nif (length === 'short') instruction = 'in 2-3 sentences';\nelse if (length === 'medium') instruction = 'in 1 paragraph';\nelse if (length === 'long') instruction = 'in 2-3 paragraphs with key points';\n\nconst prompt = `Summarize the following content ${instruction}. Style: ${style}\\n\\nContent:\\n${content}\\n\\nSummary:`;\n\nreturn { prompt, style, length };"
      },
      "id": "build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama3.1:7b"
            },
            {
              "name": "prompt",
              "value": "={{ $json.prompt }}"
            },
            {
              "name": "stream",
              "value": false
            }
          ]
        },
        "options": {}
      },
      "id": "generate-summary",
      "name": "Generate Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, summary: $json.response, style: $('Build Prompt').item.json.style, length: $('Build Prompt').item.json.length } }}"
      },
      "id": "respond-webhook-1",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
