# N8N Configuration Example
# Copy this file to .env and update with your values

# Domain configuration
DOMAIN_NAME=example.com
SUBDOMAIN=n8n

# SSL Email for Let's Encrypt certificates
SSL_EMAIL=admin@example.com

# Timezone for cron jobs and logs
# Examples: UTC, Europe/Berlin, America/New_York, Asia/Tokyo
GENERIC_TIMEZONE=UTC

# Data storage path (automatically set during installation)
DATA_FOLDER=/root/n8n-docker-caddy

# Advanced Configuration (Optional)
# Uncomment and modify if needed

# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=your-secure-password

# N8N_ENCRYPTION_KEY=your-encryption-key

# Database configuration (PostgreSQL recommended for production)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=your-db-password
